GROQ_API_KEY=
# Alternative: qwen/qwen3.6-27b
LLM_MODEL=openai/gpt-oss-120b
DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation
CACHE_DIR=data/cache
MAX_CANDIDATES_TO_LLM=20
LOG_LEVEL=INFO

# openai/gpt-oss-120b free-tier limits on Groq -- adjust if your plan/model differs
LLM_REQUESTS_PER_MINUTE=30
LLM_REQUESTS_PER_DAY=1000
LLM_TOKENS_PER_MINUTE=8000
LLM_TOKENS_PER_DAY=200000
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=20.0

# Frontend -> backend: the static frontend (frontend/index.html + app.js) is
# plain JS, not Python, so it doesn't read this .env file. It defaults to
# http://localhost:8000; to point it elsewhere, either edit the
# API_BASE_URL constant at the top of frontend/app.js, or set
# `window.API_BASE_URL = "..."` in a script tag before app.js loads in
# frontend/index.html.
